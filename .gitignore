# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.key
*.pem

# ---------------------------------------------------------------------------
# Media and model weights: large, and not ours to redistribute.
# The pipeline takes any video as an argument; nothing here is required to
# run it. Model weights are downloaded on first use by ultralytics/HF.
# ---------------------------------------------------------------------------
/media/
/weights/
*.mp4
*.mov
*.mkv
*.webm
*.avi
*.ts
*.m4v
*.h264
*.h265
*.wav
*.pt
*.onnx
*.engine

# ---------------------------------------------------------------------------
# Everything a run writes, under one root: `data/out/<video-id>/` and the
# API's `data/uploads/`. All of it is reproducible from a source video, and a
# frame store runs to hundreds of MB (95 MB for a five-minute file at 1920px).
# `FALCONVAR_DATA` moves the lot; `FALCONVAR_DATA=.` restores the old layout.
# ---------------------------------------------------------------------------
/data/
*_manifest.json
framestore/

# Eval results: reproducible by `python -m eval.<name>`, and they change on
# every run against a re-described corpus. The scripts are the source.
/eval/results/

