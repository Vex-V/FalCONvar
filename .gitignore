# ---------------------------------------------------------------------------
# Version 1 -- superseded by ver2/, kept on disk for reference only
# ---------------------------------------------------------------------------
/falconvar/
/scripts/
/test.py
/README.v1.md

# ---------------------------------------------------------------------------
# Media and model weights: large, and not ours to redistribute.
# The pipeline takes any video as an argument; nothing here is required to
# run it. Model weights are downloaded on first use by ultralytics/HF.
# ---------------------------------------------------------------------------
/media/
/weights/
*.mp4
*.mov
*.mkv
*.webm
*.avi
*.ts
*.m4v
*.h264
*.h265
*.wav
*.pt
*.onnx
*.engine

# ---------------------------------------------------------------------------
# Pipeline output: manifests, frame stores, calibration reports.
# All of it is reproducible from a source video, and a frame store runs to
# hundreds of MB (95 MB for a five-minute file at 1920px).
# ---------------------------------------------------------------------------
/out/
*_manifest.json
framestore/

