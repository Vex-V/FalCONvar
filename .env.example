# Copy to .env. Never commit the real file -- .gitignore excludes it.

# --- keys: set only the providers you use ---------------------------------
OPENAI_API=                   # or OPENAI_API_KEY
ANTHROPIC_API_KEY=
GEMINI_API_KEY=               # or GOOGLE_API_KEY
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
VOYAGE_API_KEY=
HF_TOKEN=                     # pyannote, and any gated Hugging Face model
SUPABASE_URL=
SUPABASE_SECRET_KEY=          # sb_secret_...      ingest writes
SUPABASE_PUBLISHABLE_KEY=     # sb_publishable_... consumer reads


# --- who answers ------------------------------------------------------------
# Three roles, each a provider or `provider/model`. Unset means openai and its
# default model. A flag or API field still wins over these.
#
#   describe   frames -> structured answers. The model must accept images
#   llm        text -> the `--tier llm` aggregates
#   embed      text -> vectors. `embed` and `retrieve` both read this, so a
#              search is embedded in the space the index was built in
#
# Providers: openai anthropic gemini mistral openrouter groq together deepseek
# xai voyage ollama lmstudio llamacpp local -- plus anything in
# data/providers.json. `/capabilities.models` lists them and which have a key.
#
# FALCONVAR_DESCRIBER=openai/gpt-5.4-mini
# FALCONVAR_LLM=anthropic/claude-haiku-4-5
# FALCONVAR_EMBEDDER=voyage/voyage-3.5
#
# The whole stack on this machine -- nothing leaves it, no key needed:
#
# FALCONVAR_DESCRIBER=ollama/gemma3:4b     `ollama pull gemma3:4b` first
# FALCONVAR_LLM=ollama/gemma3:4b
# FALCONVAR_EMBEDDER=local                 BAAI/bge-small-en-v1.5, in-process
#
# The model goes after the FIRST slash: `local/BAAI/bge-base-en-v1.5` is the
# `local` provider and a Hugging Face id.

# --- where a provider lives -------------------------------------------------
# <NAME>_BASE_URL moves a built-in without editing anything else:
# OLLAMA_BASE_URL=http://gpu-box:11434/v1
# LMSTUDIO_BASE_URL=http://localhost:1234/v1
#
# A new endpoint -- vLLM, a gateway, a second Ollama -- goes in
# data/providers.json. Keys stay here; the file names the variable:
#
#   {"providers": {"vllm": {"protocol": "chat",
#                           "base_url": "http://localhost:8001/v1",
#                           "key_vars": ["VLLM_API_KEY"],
#                           "chat_model": "Qwen/Qwen2.5-VL-7B-Instruct",
#                           "local": true}}}

# ---------------------------------------------------------------------------
# Where runs write. NOT read from this file -- `falconvar/shared/paths.py`
# resolves it at import, which is before `.env` is loaded, so it must be a real
# process variable. Listed here because this is where people look for knobs.
#   FALCONVAR_DATA=/srv/falconvar   out/, uploads/, prompts.json, providers.json
#   FALCONVAR_WEIGHTS=/models       share one checkpoint cache between checkouts
# ---------------------------------------------------------------------------
