# Copy to .env. Never commit the real file -- .gitignore excludes it.
OPENAI_API=
HF_TOKEN=
SUPABASE_URL=
SUPABASE_SECRET_KEY=          # sb_secret_...      ingest writes
SUPABASE_PUBLISHABLE_KEY=     # sb_publishable_... consumer reads


# --- retrieval stack ------------------------------------------------------
# Read by both `ver2.embed.driver` and `ver2.retrieve.driver`, so the two
# cannot disagree about which embedder built the index being searched. A
# command-line flag still overrides these. Unset means the defaults in
# ver2/embed/defaults.py: pgvector + openai.
#
# Postgres is the default index because it is the only one carrying the
# lexical half of the hybrid; qdrant is dense-only. Switching the whole stack
# to run locally is these three lines, not a flag on every command:
#
# FALCONVAR_INDEX=qdrant
# FALCONVAR_EMBEDDER=local
# FALCONVAR_EMBED_MODEL=nomic-ai/nomic-embed-text-v1.5
